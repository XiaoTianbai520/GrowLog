{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "仅主窗口的本地功能",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-url"
  ]
}
